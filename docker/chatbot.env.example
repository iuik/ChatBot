# Server
SERVER_PORT=8090
BOT_TIMEZONE=Asia/Shanghai

# Owner
OWNER_QQ=123456789

# OneBot
ONEBOT_API_BASE_URL=http://host.docker.internal:3000
ONEBOT_ACCESS_TOKEN=
ONEBOT_CALLBACK_TOKEN=

# Chat model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-chat

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/chatbot?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-mysql-password

# Redis
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Prompt
BOT_PROMPT_PROFILE_FILE=/app/prompts/persona.md
BOT_PROMPT_PROFILE_SOURCE_PRIORITY=file,default
BOT_PROMPT_RELOAD_FILE_EACH_REQUEST=false
BOT_PROMPT_INCLUDE_TIME_CONTEXT=true

# Human-like delivery
BOT_DELIVERY_SPLIT_ENABLED=true
BOT_DELIVERY_MAX_PARTS=3
BOT_DELIVERY_MAX_PART_CHARS=80
BOT_DELIVERY_MIN_DELAY_MILLIS=700
BOT_DELIVERY_MAX_DELAY_MILLIS=1800
BOT_DELIVERY_SPLIT_DAILY_CHAT_ONLY=true

# Embedding / Qdrant
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024

QDRANT_ENABLED=false
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
QDRANT_COLLECTION=chatbot_memory
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=1024
